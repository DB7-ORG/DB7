{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "App",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/debug/app",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "internalConsoleOptions": "openOnSessionStart",
      "MIMode": "gdb",
      "preLaunchTask": "build-debug",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Test",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/tests/all_tests",
      "args": [
        // "--gtest_filter=BTreeTest.DeleteAllThenRefill"
        "--gtest_filter=BufferPool*"
      ],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "preLaunchTask": "build-test",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Benchmark",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/benchmark/all_benchmarks",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "preLaunchTask": "build-benchmark",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}